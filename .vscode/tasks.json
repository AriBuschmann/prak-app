{
  // Aufgaben für VS Code: Terminal → "Aufgabe ausführen…" (Strg+Umschalt+P → "Tasks: Run Task").
  // Die Starts mit F5 (siehe launch.json) verwenden einige dieser Aufgaben automatisch.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/PrakApp.Api/PrakApp.Api.csproj", "/property:GenerateFullPaths=true"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "frontend: dev",
      "detail": "Vite-Entwicklungsserver auf http://localhost:9000 (läuft im Hintergrund weiter)",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/src/PrakApp.Web" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__kein_treffer__$" },
        "background": {
          "activeAtBeginning": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "backend: wait",
      "detail": "Wartet, bis das Backend auf http://localhost:5080 antwortet (höchstens 60 Sekunden)",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "for ($i = 0; $i -lt 120; $i++) { try { Invoke-WebRequest http://127.0.0.1:5080/health -UseBasicParsing -TimeoutSec 2 | Out-Null; exit 0 } catch { Start-Sleep -Milliseconds 500 } }; Write-Host 'Backend antwortet nicht. Läuft es?'; exit 1"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "frontend: start",
      "dependsOn": ["frontend: dev", "backend: wait"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "frontend: build",
      "detail": "Baut das Frontend nach src/PrakApp.Api/wwwroot",
      "type": "shell",
      "command": "pnpm build",
      "options": { "cwd": "${workspaceFolder}/src/PrakApp.Web" },
      "problemMatcher": "$tsc"
    },
    {
      "label": "test: backend",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/PrakApp.sln"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: e2e",
      "detail": "Playwright-Tests (vorher \"frontend: build\" ausführen)",
      "type": "shell",
      "command": "pnpm test:e2e",
      "options": { "cwd": "${workspaceFolder}/src/PrakApp.Web" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "db: rebuild",
      "detail": "Löscht die Datenbank PrakApp und baut sie aus den Patch-Skripten neu auf",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Database/rebuild-database.ps1"],
      "problemMatcher": []
    }
  ]
}

{
  // Aufgaben für VS Code: Terminal → "Aufgabe ausführen…" (Strg+Umschalt+P → "Tasks: Run Task").
  // Die Starts mit F5 (siehe launch.json) verwenden einige dieser Aufgaben automatisch.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/PrakApp.Api/PrakApp.Api.csproj", "/property:GenerateFullPaths=true"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "app: wait",
      "detail": "Wartet, bis Backend (Port 5080) und Vite (Port 9000) antworten – höchstens 90 Sekunden",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "for ($i = 0; $i -lt 180; $i++) { curl.exe -sf -o NUL -m 2 http://localhost:5080/health; $api = $LASTEXITCODE -eq 0; curl.exe -sf -o NUL -m 2 http://localhost:9000/; if ($api -and $LASTEXITCODE -eq 0) { exit 0 }; Start-Sleep -Milliseconds 500 }; Write-Host 'Backend oder Vite antwortet nicht.'; exit 1"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "frontend: build",
      "detail": "Baut das Frontend nach src/PrakApp.Api/wwwroot",
      "type": "shell",
      "command": "pnpm build",
      "options": { "cwd": "${workspaceFolder}/src/PrakApp.Web" },
      "problemMatcher": "$tsc"
    },
    {
      "label": "test: backend",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/PrakApp.sln"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: e2e",
      "detail": "Playwright-Tests (vorher \"frontend: build\" ausführen)",
      "type": "shell",
      "command": "pnpm test:e2e",
      "options": { "cwd": "${workspaceFolder}/src/PrakApp.Web" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "db: rebuild",
      "detail": "Löscht die Datenbank PrakApp und baut sie aus den Patch-Skripten neu auf",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Database/rebuild-database.ps1"],
      "problemMatcher": []
    }
  ]
}
